      requiresDistributor: "routeColRequiresDistributor",
      extraPapers: "rowExtraPapers",
      notes: "routeColNotes"
    }
  };
  var requiredFieldsByMode = {
    edit: {
      drivers: ["name"],
      distributors: ["name", "routes"],
      addresses: ["address"],
      routes: ["routeId"]
    },
    add: {
      drivers: ["name"],
      distributors: ["name", "routes"],
      addresses: ["address", "route", "distributor"]
    }
  };

  var filterFieldMap = {
    drivers: {
      route: ["routes"],
      status: ["status"],
      distributorName: ["distributorName"],
      driverName: ["name"],
      postnr: ["postnr"]
    },
    distributors: {
